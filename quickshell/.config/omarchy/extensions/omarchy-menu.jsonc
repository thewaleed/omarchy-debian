  "remove.terminal.foot": {"label": "Foot", "action": "omarchy-launch-floating-terminal-with-presentation 'omarchy-debian-app remove terminal.foot'", "when": "omarchy-pkg-present foot", "icon": ""},
  "remove.terminal.kitty": {"label": "Kitty", "action": "omarchy-launch-floating-terminal-with-presentation 'omarchy-debian-app remove terminal.kitty'", "when": "omarchy-pkg-present kitty", "icon": ""},
  // Arch Windows VM helper
  "remove.windows": {"icon": "󰍲", "label": "Windows", "when": "false", "action": "omarchy-launch-floating-terminal-with-presentation 'omarchy-windows-vm remove'"},
  // fcitx5 is not installed, so there is nothing to restart
  "setup.config.xcompose": {"icon": "󰞅", "label": "XCompose", "action": "omarchy-launch-config-editor ~/.XCompose && omarchy-restart-xcompose", "when": "false"},
  "setup.default.agent.agy": {"icon": "󰫢", "label": "Antigravity", "checked": "[[ \"$(omarchy-default-agent)\" == \"agy\" ]]", "action": "omarchy-default-agent agy", "when": "omarchy-cmd-present agy"},
  "setup.default.agent.claude": {"icon": "󰛄", "label": "Claude", "checked": "[[ \"$(omarchy-default-agent)\" == \"claude\" ]]", "action": "omarchy-default-agent claude", "when": "omarchy-cmd-present claude"},
  "setup.default.agent.codex": {"icon": "", "iconFont": "omarchy", "label": "Codex", "checked": "[[ \"$(omarchy-default-agent)\" == \"codex\" ]]", "action": "omarchy-default-agent codex", "when": "omarchy-cmd-present codex"},
  "setup.default.agent.copilot": {"icon": "", "label": "Copilot", "checked": "[[ \"$(omarchy-default-agent)\" == \"copilot\" ]]", "action": "omarchy-default-agent copilot", "when": "omarchy-cmd-present copilot"},
  "setup.default.agent.crush": {"icon": "󰋑", "label": "Crush", "checked": "[[ \"$(omarchy-default-agent)\" == \"crush\" ]]", "action": "omarchy-default-agent crush", "when": "omarchy-cmd-present crush"},
  "setup.default.agent.cursor-agent": {"icon": "", "iconFont": "omarchy", "label": "Cursor CLI", "checked": "[[ \"$(omarchy-default-agent)\" == \"cursor-agent\" ]]", "action": "omarchy-default-agent cursor-agent", "when": "omarchy-cmd-present cursor-agent"},
  "setup.default.agent.grok": {"icon": "", "iconFont": "omarchy", "label": "Grok", "checked": "[[ \"$(omarchy-default-agent)\" == \"grok\" ]]", "action": "omarchy-default-agent grok", "when": "omarchy-cmd-present grok"},
  "setup.default.agent.hermes": {"icon": "", "iconFont": "omarchy", "label": "Hermes", "checked": "[[ \"$(omarchy-default-agent)\" == \"hermes\" ]]", "action": "omarchy-default-agent hermes", "when": "omarchy-cmd-present hermes"},
  "setup.default.agent.muse": {"icon": "󰛤", "label": "Muse Code", "checked": "[[ \"$(omarchy-default-agent)\" == \"muse\" ]]", "action": "omarchy-default-agent muse", "when": "omarchy-cmd-present muse"},
  "setup.default.agent.omp": {"icon": "", "iconFont": "omarchy", "label": "omp", "checked": "[[ \"$(omarchy-default-agent)\" == \"omp\" ]]", "action": "omarchy-default-agent omp", "when": "omarchy-cmd-present omp"},
  "setup.default.agent.openclaw": {"icon": "", "iconFont": "omarchy", "label": "OpenClaw", "checked": "[[ \"$(omarchy-default-agent)\" == \"openclaw\" ]]", "action": "omarchy-default-agent openclaw", "when": "omarchy-cmd-present openclaw"},
  "setup.default.agent.opencode": {"icon": "", "iconFont": "omarchy", "label": "OpenCode", "checked": "[[ \"$(omarchy-default-agent)\" == \"opencode\" ]]", "action": "omarchy-default-agent opencode", "when": "omarchy-cmd-present opencode"},
  "setup.default.agent.ori": {"icon": "", "iconFont": "omarchy", "label": "Ori", "checked": "[[ \"$(omarchy-default-agent)\" == \"ori\" ]]", "action": "omarchy-default-agent ori", "when": "omarchy-cmd-present ori"},
  "setup.default.agent.pi": {"icon": "", "iconFont": "omarchy", "label": "Pi", "checked": "[[ \"$(omarchy-default-agent)\" == \"pi\" ]]", "action": "omarchy-default-agent pi", "when": "omarchy-cmd-present pi"},
  // no Debian source
  "setup.default.browser.brave-origin": {"icon": "󰖟", "label": "Brave Origin", "checked": "[[ \"$(omarchy-default-browser)\" == \"brave-origin\" ]]", "action": "omarchy-default-browser brave-origin", "when": "false"},
  // no Debian source
  "setup.default.editor.cursor": {"icon": "", "iconFont": "omarchy", "label": "Cursor", "checked": "[[ \"$(omarchy-default-editor)\" == \"cursor\" ]]", "action": "omarchy-default-editor cursor", "when": "false"},
  // no Debian source
  "setup.default.editor.helix": {"icon": "", "label": "Helix", "checked": "[[ \"$(omarchy-default-editor)\" == \"helix\" ]]", "action": "omarchy-default-editor helix", "when": "false"},
  // no Debian source
  "setup.default.terminal.ghostty": {"icon": "", "label": "Ghostty", "checked": "[[ \"$(omarchy-default-terminal)\" == \"ghostty\" ]]", "action": "omarchy-default-terminal ghostty", "when": "false"},
  // Arch Limine/UKI boot setup
  "setup.direct-boot": {"icon": "", "label": "Direct Boot", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-setup-direct-boot", "when": "false"},
  // Arch factory reset
  "setup.reset": {"icon": "󰑓", "label": "Reset Computer", "when": "false", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-system-factory-reset"},
  // no fingerprint reader
  "setup.security.fingerprint": {"icon": "󰈷", "label": "Fingerprint", "when": "false", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-setup-security-fingerprint"},
  // sudo is already passwordless via /etc/sudoers.d/99-thewaleed
  "setup.security.passwordless-sudo": {"icon": "󰟵", "label": "Passwordless Sudo", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-sudo-passwordless", "when": "false"},
  "setup.security.sudoless-docker": {"icon": "󰡨", "label": "Sudoless Docker", "when": "omarchy-cmd-present docker && omarchy-sudo-docker --configured", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-setup-security-sudoless-docker"},
  // Plymouth is not used on this system
  "style.unlock": {"icon": "󰟵", "label": "Unlock", "aliases": ["unlock"], "action": "unlock=$(omarchy-plymouth-switcher); if [[ $unlock == default ]]; then omarchy-launch-floating-terminal-with-presentation omarchy-plymouth-reset; elif [[ -n $unlock ]]; then omarchy-launch-floating-terminal-with-presentation \"omarchy-plymouth-set-by-theme $(printf %q \"$unlock\")\"; fi", "when": "false"},
  "trigger.capture.screenrecord.stop": {"icon": "", "label": "Stop Screenrecording", "when": "pgrep -f '^wf-recorder'", "action": "omarchy-capture-screenrecording --stop-recording"},
  // webcam overlay not ported to wf-recorder
  "trigger.capture.screenrecord.webcam": {"icon": "", "label": "With desktop + microphone audio + webcam", "when": "false", "action": "omarchy-capture-screenrecording-with-webcam"},
  // Arch supergfxctl integration
  "trigger.hardware.hybrid-gpu": {"icon": "", "label": "Hybrid GPU", "when": "false", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-toggle-hybrid-gpu"},
  "trigger.share.receive": {"icon": "󰥦", "label": "Receive", "action": "localsend_app", "when": "omarchy-cmd-present localsend_app"},
  // crash watcher service is not installed
  "trigger.toggle.crash-capture": {"icon": "󱚡", "label": "Crash Capture", "action": "omarchy-toggle-crash-capture", "when": "false"},
  // no-op while the lock plugin is disabled (lock/idle checkpoint)
  "trigger.toggle.idle-lock": {"icon": "󰅶", "label": "Stay Awake", "action": "omarchy-toggle-idle", "when": "false"},
  // Omarchy release channels are Arch-only
  "update.channel": {"icon": "󰔫", "label": "Channel", "when": "false"},
  // would overwrite the Stow-managed ~/.config/hypr
  "update.config.hyprland": {"icon": "", "label": "Hyprland", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-refresh-hyprland", "when": "false"},
  // Plymouth is not used on this system
  "update.config.plymouth": {"icon": "󱣴", "label": "Plymouth", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-refresh-plymouth", "when": "false"},
  // would reset shell.json and re-enable lock/idle
  "update.config.shell": {"icon": "󰍜", "label": "Shell", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-refresh-shell", "when": "false"},
  "update.omarchy": {"icon": "", "iconFont": "", "label": "System", "action": "omarchy-debian-update", "description": "APT full-upgrade and Flatpak update"},
  "update.password.drive": {"icon": "", "label": "Drive Encryption", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-drive-password", "when": "lsblk -rno TYPE | grep -qx crypt"},
}
