#!/bin/bash

# omarchy:summary=Update Debian and Flatpak packages
# omarchy:examples=omarchy update

# Debian port: upstream ran the pacman/AUR/snapper pipeline here. Keep the
# `omarchy update` command working by handing off to the same APT + Flatpak
# flow the bar's update icon and the Update > System menu row use.
exec omarchy-debian-update "$@"
