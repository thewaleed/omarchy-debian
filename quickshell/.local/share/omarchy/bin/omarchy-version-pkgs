#!/bin/bash

# omarchy:summary=Print when system packages were last upgraded

# Debian: the last completed APT transaction in the history log.
last=$(zgrep -h '^End-Date:' /var/log/apt/history.log* 2>/dev/null | sed 's/^End-Date: *//' | sort | tail -1)
[[ -n $last ]] || exit 1
date -d "$last" "+%A, %B %d %Y at %H:%M"
