#!/bin/bash

# omarchy:summary=Prune superseded package files from the APT cache
# omarchy:requires-sudo=true

set -e

# autoclean only drops .debs the mirrors no longer offer, so the current
# versions stay cached for an offline reinstall.
echo -e "\e[32m\nPrune package cache\e[0m"
sudo apt-get autoclean || echo -e "\e[33mCould not prune the package cache.\e[0m" >&2
echo
