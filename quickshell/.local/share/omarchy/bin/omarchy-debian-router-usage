#!/usr/bin/python3
# omarchy:summary=Print a usage record for an API-key router provider as JSON
# omarchy:args=<openrouter|orcarouter> [--force] [--limits-only]
# omarchy:hidden=true
"""Collect usage for API-key "router" providers (OpenRouter, OrcaRouter).

Debian addition, called by omarchy-agent-usage-openrouter/-orcarouter. Local
stats come from sessions that ran on the provider: the OpenCode database and
any saved pi session logs. The balance comes from the provider's own API with
the key OpenCode (or pi) already stores. The agents panel only reads the JSON
this prints, in the same shape as the upstream collectors.
"""

from __future__ import annotations

import argparse
import glob
import json
import os
import sqlite3
import sys
import urllib.error
import urllib.request
from datetime import date, datetime, timedelta, timezone
from pathlib import Path
from typing import Any

HOME = Path.home()
DATA_HOME = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local" / "share")
OPENCODE_DB = DATA_HOME / "opencode" / "opencode.db"
OPENCODE_AUTH = DATA_HOME / "opencode" / "auth.json"
PI_SESSIONS = HOME / ".pi" / "agent" / "sessions"
PI_AUTH = HOME / ".pi" / "agent" / "auth.json"

PROVIDERS = {
  "openrouter": {"name": "OpenRouter", "env": "OPENROUTER_API_KEY", "api": "https://openrouter.ai/api/v1"},
  "orcarouter": {"name": "OrcaRouter", "env": "ORCAROUTER_API_KEY", "api": "https://api.orcarouter.ai/v1"},
}
# OpenAI-shape billing reports this ceiling for keys without a spending limit.
UNLIMITED_USD = 1_000_000


class ProviderError(Exception):
  pass


def number(value: Any) -> int:
  try:
    return max(0, round(float(value or 0)))
  except (TypeError, ValueError):
    return 0


def local_day(ms: Any) -> str:
  try:
    return datetime.fromtimestamp(float(ms) / 1000, tz=timezone.utc).astimezone().date().isoformat()
  except (TypeError, ValueError, OverflowError, OSError):
    return ""


class Stats:
  def __init__(self) -> None:
    self.prompts: dict[str, int] = {}            # day -> prompts
    self.sessions: dict[str, set[str]] = {}      # day -> session ids
    self.all_sessions: set[str] = set()
    self.tokens: dict[str, int] = {}             # day -> tokens
    self.today_by_model: dict[str, int] = {}
    self.model_usage: dict[str, dict[str, int]] = {}
    self.today = datetime.now().astimezone().date().isoformat()

  def prompt(self, day: str, session: str) -> None:
    if not day:
      return
    self.prompts[day] = self.prompts.get(day, 0) + 1
    self.sessions.setdefault(day, set()).add(session)
    self.all_sessions.add(session)

  def reply(self, day: str, session: str, model: str, uncached: int, output: int, read: int, write: int) -> None:
    total = uncached + output + read + write
    self.all_sessions.add(session)
    if not day or total <= 0:
      return
    self.sessions.setdefault(day, set()).add(session)
    self.tokens[day] = self.tokens.get(day, 0) + total
    usage = self.model_usage.setdefault(model or "unknown", {
      "inputTokens": 0, "outputTokens": 0, "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0,
    })
    usage["inputTokens"] += uncached
    usage["outputTokens"] += output
    usage["cacheReadInputTokens"] += read
    usage["cacheCreationInputTokens"] += write
    if day == self.today:
      self.today_by_model[model or "unknown"] = self.today_by_model.get(model or "unknown", 0) + total

  def fields(self) -> dict[str, Any]:
    today = date.fromisoformat(self.today)
    recent = [(today - timedelta(days=offset)).isoformat() for offset in range(6, -1, -1)]
    active = sorted(set(self.prompts) | set(self.tokens))
    return {
      "todayPrompts": self.prompts.get(self.today, 0),
      "todaySessions": len(self.sessions.get(self.today, set())),
      "todayTotalTokens": sum(self.today_by_model.values()),
      "todayTokensByModel": self.today_by_model,
      "recentDays": [{"date": day, "messageCount": self.tokens.get(day, 0)} for day in recent],
      "totalPrompts": sum(self.prompts.values()),
      "totalSessions": len(self.all_sessions),
      "activeDays": len(active),
      "activeDates": active,
      "modelUsage": self.model_usage,
    }


def scan_opencode(provider: str, stats: Stats) -> bool:
  if not OPENCODE_DB.is_file():
    return False
  try:
    db = sqlite3.connect(f"file:{OPENCODE_DB}?mode=ro", uri=True, timeout=5)
    rows = db.execute("select session_id, data from message order by time_created").fetchall()
  except sqlite3.Error:
    return False
  found = False
  for session, raw in rows:
    try:
      data = json.loads(raw)
    except (TypeError, json.JSONDecodeError):
      continue
    role = data.get("role")
    created = (data.get("time") or {}).get("created")
    if role == "user" and (data.get("model") or {}).get("providerID") == provider:
      stats.prompt(local_day(created), "opencode:" + session)
      found = True
    elif role == "assistant" and data.get("providerID") == provider:
      tokens = data.get("tokens") or {}
      cache = tokens.get("cache") or {}
      stats.reply(local_day(created), "opencode:" + session, str(data.get("modelID") or ""),
                  number(tokens.get("input")), number(tokens.get("output")) + number(tokens.get("reasoning")),
                  number(cache.get("read")), number(cache.get("write")))
      found = True
  return found


def scan_pi(provider: str, stats: Stats) -> bool:
  # pi is no longer installed, but its saved sessions are still real usage.
  found = False
  for path in glob.glob(str(PI_SESSIONS / "*" / "*.jsonl")):
    session = "pi:" + Path(path).stem
    pending: list[str] = []
    try:
      lines = open(path, errors="ignore").read().splitlines()
    except OSError:
      continue
    for line in lines:
      try:
        entry = json.loads(line)
      except json.JSONDecodeError:
        continue
      message = entry.get("message") or {}
      if message.get("role") == "user":
        pending.append(local_day(message.get("timestamp")))
      elif message.get("role") == "assistant":
        # A prompt belongs to the provider that answered it.
        if message.get("provider") == provider:
          for day in pending:
            stats.prompt(day, session)
          usage = message.get("usage") or {}
          stats.reply(local_day(message.get("timestamp")), session, str(message.get("model") or ""),
                      number(usage.get("input")), number(usage.get("output")),
                      number(usage.get("cacheRead")), number(usage.get("cacheWrite")))
          found = True
        pending = []
  return found


def read_json(path: Path) -> dict[str, Any]:
  try:
    parsed = json.loads(path.read_text())
    return parsed if isinstance(parsed, dict) else {}
  except (OSError, json.JSONDecodeError):
    return {}


def api_key(provider: str, env: str) -> str:
  opencode = read_json(OPENCODE_AUTH).get(provider) or {}
  pi = read_json(PI_AUTH).get(provider) or {}
  return (
    str(os.environ.get(env, "")).strip()
    or str(opencode.get("key") or "").strip()
    or str(pi.get("key") or pi.get("access") or "").strip()
  )


def get(url: str, key: str) -> dict[str, Any]:
  request = urllib.request.Request(url, headers={"Authorization": "Bearer " + key, "Accept": "application/json"})
  try:
    with urllib.request.urlopen(request, timeout=15) as response:
      decoded = json.load(response)
      return decoded if isinstance(decoded, dict) else {}
  except urllib.error.HTTPError as error:
    if error.code in (401, 403):
      raise ProviderError("The API key was rejected")
    raise ProviderError(f"API returned HTTP {error.code}")
  except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as error:
    raise ProviderError("Could not reach the API") from error


def openrouter_balance(api: str, key: str) -> dict[str, Any]:
  data = get(api + "/credits", key).get("data") or {}
  funded = float(data.get("total_credits") or 0)
  spent = float(data.get("total_usage") or 0)
  return {"remaining": max(0.0, funded - spent), "funded": funded, "spent": spent, "currency": "USD", "estimated": False}


def orcarouter_balance(api: str, key: str) -> dict[str, Any] | None:
  subscription = get(api + "/dashboard/billing/subscription", key)
  limit = float(subscription.get("hard_limit_usd") or 0)
  # OpenAI-shape total_usage is in cents.
  spent = float(get(api + "/dashboard/billing/usage", key).get("total_usage") or 0) / 100
  if limit <= 0 or limit >= UNLIMITED_USD:
    return None
  return {"remaining": max(0.0, limit - spent), "funded": limit, "spent": spent, "currency": "USD", "estimated": False}


def record_for(provider: str) -> dict[str, Any]:
  config = PROVIDERS[provider]
  stats = Stats()
  local = scan_opencode(provider, stats)
  local = scan_pi(provider, stats) or local
  record: dict[str, Any] = {
    "schemaVersion": 1,
    "id": provider,
    "name": config["name"],
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": local,
    "hasLocalStats": local,
    "tierLabel": "Pay as you go",
    "usageStatusText": "",
    "authHelpText": "",
    "limits": [],
  }
  record.update(stats.fields())

  key = api_key(provider, config["env"])
  if not key:
    record["authHelpText"] = f"Set {config['env']} or sign in to {config['name']} in opencode."
    return record
  try:
    balance = openrouter_balance(config["api"], key) if provider == "openrouter" else orcarouter_balance(config["api"], key)
  except ProviderError as error:
    record["usageStatusText"] = "Balance unavailable"
    record["authHelpText"] = f"{config['name']}: {error}"
    return record
  if balance:
    record["balance"] = balance
    record["tierLabel"] = "Prepaid"
  record["ready"] = True
  return record


def main() -> int:
  parser = argparse.ArgumentParser(description="Print a router provider usage record as JSON")
  parser.add_argument("provider", choices=sorted(PROVIDERS))
  # Accepted so every collector takes the same invocation; there is no cache.
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()
  try:
    record = record_for(args.provider)
  except Exception as error:
    name = PROVIDERS[args.provider]["name"]
    record = {"schemaVersion": 1, "id": args.provider, "name": name, "ready": False,
              "usageStatusText": f"{name} unavailable", "authHelpText": "Usage scan failed", "limits": []}
    print(f"omarchy-debian-router-usage: {type(error).__name__}", file=sys.stderr)
  print(json.dumps(record, separators=(",", ":")))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
