{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": { "name": "tokyonight", "mode": "system" },
  "animations": true,
  "cursor": { "style": "block", "blinking": true },
  "mouse": true,
  "scroll": { "speed": 3, "acceleration": false },
  "prompt": { "editor": true, "paste": "compact", "image_preview": false },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "grouping": "auto",
    "image_preview": false,
    "tps": true,
    "markdown": "rendered",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "tabs": { "mode": "auto", "scope": "cwd", "layout": "horizontal", "indicators": "status" },
  "diffs": { "source": "branch", "wrap": "word", "tree": true, "single": false, "view": "auto" },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default",
    "sounds": { "permission": "/path/to/permission.wav" }
  },
  "highlights": false,
  "terminal": { "title": true, "copy": "select" },
  "mini": {
    "thinking": "show",
    "tools": "hide",
    "shell_output": "hide",
    "turn_summary": "show",
    "footer": "show",
    "splash": "show",
    "work_spinner": "block-soft-slide",
    "mono": false,
    "replay": true,
    "replay_limit": 200
  },
  "keybinds": {
    "leader": "ctrl+x",
    "command.palette.show": "ctrl+p",
    "model.list": "<leader>m",
    "agent.list": "<leader>a",
    "session.new": "<leader>n",
    "session.undo": "<leader>u",
    "session.redo": "<leader>r",
    "app.exit": ["ctrl+c", "ctrl+d", "<leader>q"],
    "app.debug": false,
    "prompt.paste": { "key": "ctrl+v", "event": "press", "preventDefault": false, "fallthrough": false }
  },
  "leader": { "timeout": 2000 },
  "plugins": [
    "./herdr-opencode",
    { "package": "./plugins/status", "options": { "compact": true } }
  ],
  "debug": { "devtools": false, "timing": false, "turn_tokens": false },
  "experimental": {}
}
