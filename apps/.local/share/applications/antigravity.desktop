# Antigravity IDE tarball install in /opt/antigravity-ide, on the data folder
# kept from the 1.x install so settings and sign-in carry over.
[Desktop Entry]
Name=Antigravity IDE
Comment=Experience liftoff
GenericName=Text Editor
Exec=/opt/antigravity-ide/antigravity-ide --user-data-dir=/home/thewaleed/.config/Antigravity-IDE %F
Icon=antigravity-ide
Type=Application
StartupNotify=false
StartupWMClass=antigravity-ide
Categories=TextEditor;Development;IDE;
Actions=new-empty-window;
Keywords=vscode;

[Desktop Action new-empty-window]
Name=New Empty Window
Name[cs]=Nové prázdné okno
Name[de]=Neues leeres Fenster
Name[es]=Nueva ventana vacía
Name[fr]=Nouvelle fenêtre vide
Name[it]=Nuova finestra vuota
Name[ja]=新しい空のウィンドウ
Name[ko]=새 빈 창
Name[ru]=Новое пустое окно
Name[zh_CN]=新建空窗口
Name[zh_TW]=開新空視窗
Exec=/opt/antigravity-ide/antigravity-ide --user-data-dir=/home/thewaleed/.config/Antigravity-IDE --new-window %F
Icon=antigravity-ide
MimeType=x-scheme-handler/antigravity-ide;application/x-antigravity-workspace;
