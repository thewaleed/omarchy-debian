# Personal override: run the Antigravity IDE with its own data folder, since
# the Antigravity 2.0 app (/opt) already uses ~/.config/Antigravity.
[Desktop Entry]
Name=Antigravity IDE
Comment=Experience liftoff
GenericName=Text Editor
Exec=/usr/share/antigravity/antigravity --user-data-dir=/home/thewaleed/.config/Antigravity-IDE %F
Icon=antigravity
Type=Application
StartupNotify=false
StartupWMClass=Antigravity
Categories=TextEditor;Development;IDE;
Actions=new-empty-window;
Keywords=vscode;

[Desktop Action new-empty-window]
Name=New Empty Window
Name[cs]=Nové prázdné okno
Name[de]=Neues leeres Fenster
Name[es]=Nueva ventana vacía
Name[fr]=Nouvelle fenêtre vide
Name[it]=Nuova finestra vuota
Name[ja]=新しい空のウィンドウ
Name[ko]=새 빈 창
Name[ru]=Новое пустое окно
Name[zh_CN]=新建空窗口
Name[zh_TW]=開新空視窗
Exec=/usr/share/antigravity/antigravity --user-data-dir=/home/thewaleed/.config/Antigravity-IDE --new-window %F
Icon=antigravity
MimeType=x-scheme-handler/antigravity;application/x-antigravity-workspace;
